# Entra ID app registration (public client). Required.
TEAMS_MCP_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant: your tenant GUID or domain for single-tenant; "organizations" for any
# work/school account; "common" for work + personal. Default: organizations
TEAMS_MCP_TENANT_ID=organizations

# Optional: where the token cache (incl. refresh token) is stored.
# Default: ~/.teams-mcp-token-cache.json
# TEAMS_MCP_TOKEN_CACHE=/absolute/path/to/.teams-mcp-token-cache.json
